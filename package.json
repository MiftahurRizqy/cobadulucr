{
    "$schema": "https://www.schemastore.org/package.json",
    "private": true,
    "type": "module",
    "scripts": {
        "build": "vite build",
        "dev": "vite --host 127.0.0.1",
        "dev:crm": "concurrently --names \"LARAVEL,VITE\" --prefix-colors \"green,cyan\" \"php artisan serve --host=127.0.0.1 --port=8000\" \"npm run dev\"",
        "dev:vite": "vite --host 127.0.0.1 --force"
    },
    "devDependencies": {
        "@tailwindcss/vite": "^4.0.0",
        "axios": "^1.11.0",
        "concurrently": "^9.0.1",
        "laravel-vite-plugin": "^2.0.0",
        "tailwindcss": "^4.0.0",
        "vite": "^7.0.7"
    },
    "dependencies": {
        "alpinejs": "^3.15.12",
        "exifr": "^7.1.3",
        "heic-convert": "^2.1.0",
        "heic2any": "^0.0.4"
    }
}
